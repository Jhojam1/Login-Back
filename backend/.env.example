# ============================================================================
#  PLANTILLA DE CONFIGURACION
#
#  1. Copia este archivo y llamalo .env (en esta misma carpeta, backend/)
#  2. Rellena los valores
#  3. Arranca el backend como siempre
#
#  .env esta en el .gitignore: NUNCA se sube al repositorio. Este .env.example si
#  se sube, por eso aqui solo hay valores de ejemplo, nunca contrasenas reales.
#
#  Formato: CLAVE=valor, sin comillas y sin espacios alrededor del "=".
#  Si una contrasena contiene una barra invertida \, escribela doble: \\
# ============================================================================


# ---------------------------------------------------------------------------
#  Perfil
#    dev  = base de datos H2 en memoria (no usa nada de lo de abajo)
#    prod = PostgreSQL con los datos de abajo
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod


# ---------------------------------------------------------------------------
#  Base de datos PostgreSQL
#
#  Opcion A - PostgreSQL local con Docker (para probar en tu PC):
#      docker compose up -d        (desde la raiz del proyecto)
#      DB_HOST=localhost  DB_NAME=authdb  DB_USERNAME=authadmin  DB_PASSWORD=authpass
#
#  Opcion B - AWS RDS:
#      DB_HOST es el "Endpoint" que aparece en la consola de RDS, por ejemplo
#      auth-db.c9xxxxxxxx.us-east-1.rds.amazonaws.com
#      DB_NAME es el "Initial database name" que pusiste al crearla
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authdb
DB_USERNAME=authadmin
DB_PASSWORD=authpass

# prefer = cifra si el servidor lo permite (sirve para local y para RDS)
# require = exige cifrado (recomendado para RDS en produccion)
DB_SSLMODE=prefer

# update = crea las tablas que falten (la primera vez)
# validate = solo comprueba, no toca nada (cuando ya existan)
DDL_AUTO=update


# ---------------------------------------------------------------------------
#  Seguridad - genera valores propios con:  openssl rand -base64 48
#  (en Windows sin openssl, cualquier cadena aleatoria de 40+ caracteres sirve)
# ---------------------------------------------------------------------------
APP_JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres
APP_SERVICE_API_KEY=cambia-esto-por-otra-cadena-aleatoria-distinta


# ---------------------------------------------------------------------------
#  Administrador inicial (solo se crea si no existe)
# ---------------------------------------------------------------------------
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@proyecto.com
APP_ADMIN_PASSWORD=Admin.2026


# ---------------------------------------------------------------------------
#  Origenes desde los que se permite llamar a la API (la URL del frontend)
# ---------------------------------------------------------------------------
APP_ALLOWED_ORIGINS=http://localhost:5173
