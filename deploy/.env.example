# =============================================================================
#  Configuracion del despliegue en el EC2.
#
#  Copiar como .env en la misma carpeta que el docker-compose.yml de la instancia
#  (~/login-deploy/) y rellenar. Es el UNICO archivo de configuracion del
#  servidor: de aqui salen tanto las imagenes a descargar como las credenciales
#  que recibe el contenedor del backend.
#
#  Protegerlo para que solo lo lea tu usuario:
#      chmod 600 ~/login-deploy/.env
#
#  NUNCA se sube a Git.
#
#  Formato: CLAVE=valor, sin comillas y sin espacios alrededor del "=".
#  Si un valor contiene el simbolo $, escribelo doble ($$): Docker Compose
#  interpreta un $ suelto como el principio del nombre de otra variable.
# =============================================================================


# ---------------------------------------------------------------------------
#  Que imagenes descargar
#
#  Tu usuario de Docker Hub seguido del nombre del repositorio. El compose le
#  anade ":backend-latest" y ":frontend-latest" a cada servicio.
# ---------------------------------------------------------------------------
IMAGE_REPO=tu-usuario-dockerhub/login


# ---------------------------------------------------------------------------
#  Base de datos: los datos de AWS RDS (paso 4 de la guia de AWS)
# ---------------------------------------------------------------------------
DB_HOST=auth-db.c9xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=authdb
DB_USERNAME=authadmin
DB_PASSWORD=la-contrasena-que-pusiste-en-rds

# RDS con PostgreSQL 15 o superior exige conexion cifrada
DB_SSLMODE=require

# "update" crea las tablas que falten (la primera vez).
# Cambialo a "validate" cuando el sistema ya funcione.
DDL_AUTO=update


# ---------------------------------------------------------------------------
#  Seguridad. Genera cada valor con:  openssl rand -base64 48
# ---------------------------------------------------------------------------
APP_JWT_SECRET=pega-aqui-una-cadena-aleatoria-de-al-menos-32-caracteres
APP_SERVICE_API_KEY=pega-aqui-otra-cadena-aleatoria-distinta


# ---------------------------------------------------------------------------
#  Administrador inicial (solo se crea la primera vez)
# ---------------------------------------------------------------------------
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@proyecto.com
APP_ADMIN_PASSWORD=CambiaEstaClave.2026


# ---------------------------------------------------------------------------
#  Desde donde se permite llamar a la API.
#  Pon la IP publica de tu EC2. Con Docker el frontend y la API comparten
#  dominio, asi que esto solo importa si alguien llama a la API desde fuera.
# ---------------------------------------------------------------------------
APP_ALLOWED_ORIGINS=http://52.14.23.45

